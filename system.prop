# ADB
ro.adb.secure=0
ro.boot.dynamic_partitions=true

# Gatekeeper (Disable SPU, fallback to TEE for TWRP Decryption)
vendor.gatekeeper.disable_spu=true
vendor.gatekeeper.is_security_level_spu=0

# Battery
ro.charger.enable_suspend=1

# Crypto / FBE v2 (Android 15 /data decryption for TWRP)
ro.crypto.type=file
ro.crypto.state=encrypted
ro.crypto.volume.filenames_mode=aes-256-cts
ro.crypto.volume.metadata.method=dm-default-key
ro.crypto.volume.options=::v2
ro.hardware.keystore=default
ro.hardware.keymaster=default
